# SMTP account used ONLY to send your test message
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sending-account@example.com
SMTP_PASS=your-sending-account-password
FROM_EMAIL=your-sending-account@example.com
FROM_NAME=Inbox Tester

# Test mailbox 1
BOX1_EMAIL=michpres12@gmail.com
BOX1_IMAP_HOST=imap.gmail.com
BOX1_IMAP_PORT=993
BOX1_IMAP_SECURE=true
BOX1_IMAP_USER=michpres12@gmail.com
BOX1_IMAP_PASS=USE_A_GOOGLE_APP_PASSWORD_OR_OAUTH

# Test mailbox 2
BOX2_EMAIL=haryjack986@gmail.com
BOX2_IMAP_HOST=imap.gmail.com
BOX2_IMAP_PORT=993
